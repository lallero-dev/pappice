# Copy to /etc/pappice/pappice.env and keep it mode 0640 root:pappice.
# Replace the hostname. Optional settings: ../../.env.example. Email defaults to off.

PAPPICE_ADDR=127.0.0.1:8388
PAPPICE_PUBLIC_URL=https://support.example.com

PAPPICE_DB=/var/lib/pappice/pappice.db
PAPPICE_UPLOAD_DIR=/var/lib/pappice/uploads
PAPPICE_BACKUP_DIR=/var/backups/pappice

# Trust the private HTTPS proxy; keep Pappice's port private.
PAPPICE_TRUST_PROXY_HEADERS=true
