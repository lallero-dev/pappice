# Copy to deploy/docker/pappice.env and replace the hostname.
# Keep the image's listener/storage defaults to match Compose ports and volumes.
# Optional settings: ../../.env.example. Email defaults to off.

PAPPICE_PUBLIC_URL=https://support.example.com

# Trust the private HTTPS proxy; keep Pappice's port private.
PAPPICE_TRUST_PROXY_HEADERS=true
